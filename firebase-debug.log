[debug] [2026-09-25T11:55:22.861Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/pass-vault-manager/rulesets {"name":"projects/pass-vault-manager/rulesets/0c86ae72-81b5-4dac-bce1-3490bfb1c4dc","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // Helper functions\n    function isAuthenticated() {\n      return request.auth != null;\n    }\n\n    function isOwner(userId) {\n      return isAuthenticated() && request.auth.uid == userId;\n    }\n\n    function isNonEmptyString(val, maxLen) {\n      return val is string && val.size() > 0 && val.size() <= maxLen;\n    }\n\n    function isOptionalString(data, field, maxLen) {\n      return !(field in data) || data[field] == null || (data[field] is string && data[field].size() <= maxLen);\n    }\n\n    function isValidTagList(tags) {\n      return tags is list && tags.size() <= 20;\n    }\n\n    // Default deny for all unmatched collections\n    match /{document=**} {\n      allow read, write: if false;\n    }\n\n    // User scope: All user-specific data lives strictly under /users/{userId}\n    match /users/{userId} {\n      // User root doc: basic profile/metadata\n      allow read, write: if isOwner(userId);\n\n      // Credentials collection\n      match /credentials/{credentialId} {\n        allow read, delete: if isOwner(userId);\n\n        allow create: if isOwner(userId)\n          && isNonEmptyString(request.resource.data.title, 100)\n          && isNonEmptyString(request.resource.data.encryptedUsername, 2048)\n          && isNonEmptyString(request.resource.data.encryptedPassword, 4096)\n          && isOptionalString(request.resource.data, 'encryptedNotes', 10000)\n          && isOptionalString(request.resource.data, 'encryptedRecoveryEmail', 2048)\n          && isOptionalString(request.resource.data, 'encryptedMobile', 1024)\n          && isOptionalString(request.resource.data, 'encryptedSecurityQuestions', 10000)\n          && isOptionalString(request.resource.data, 'websiteUrl', 2048)\n          && isOptionalString(request.resource.data, 'categoryId', 50)\n          && (!('tags' in request.resource.data) || isValidTagList(request.resource.data.tags))\n          && (!('lastLoginAt' in request.resource.data) || request.resource.data.lastLoginAt == null || request.resource.data.lastLoginAt is timestamp)\n          && request.resource.data.createdAt is timestamp\n          && request.resource.data.updatedAt is timestamp;\n\n        allow update: if isOwner(userId)\n          && isNonEmptyString(request.resource.data.title, 100)\n          && isNonEmptyString(request.resource.data.encryptedUsername, 2048)\n          && isNonEmptyString(request.resource.data.encryptedPassword, 4096)\n          && isOptionalString(request.resource.data, 'encryptedNotes', 10000)\n          && isOptionalString(request.resource.data, 'encryptedRecoveryEmail', 2048)\n          && isOptionalString(request.resource.data, 'encryptedMobile', 1024)\n          && isOptionalString(request.resource.data, 'encryptedSecurityQuestions', 10000)\n          && isOptionalString(request.resource.data, 'websiteUrl', 2048)\n          && isOptionalString(request.resource.data, 'categoryId', 50)\n          && (!('tags' in request.resource.data) || isValidTagList(request.resource.data.tags))\n          && (!('lastLoginAt' in request.resource.data) || request.resource.data.lastLoginAt == null || request.resource.data.lastLoginAt is timestamp)\n          && request.resource.data.createdAt == resource.data.createdAt\n          && request.resource.data.updatedAt is timestamp;\n      }\n\n      // Categories collection (for user-created custom categories & system overrides)\n      match /categories/{categoryId} {\n        allow read, delete: if isOwner(userId);\n\n        allow create, update: if isOwner(userId)\n          && (\n               (!('label' in request.resource.data) && request.resource.data.isDeleted == true)\n               || isNonEmptyString(request.resource.data.label, 50)\n             )\n          && isOptionalString(request.resource.data, 'icon', 50);\n      }\n\n      // Settings collection (e.g. vault preferences)\n      match /settings/{settingId} {\n        allow read, write: if isOwner(userId);\n      }\n    }\n  }\n}\n\n","name":"firestore.rules"}]},"createTime":"2026-09-25T11:55:23.956559Z","metadata":{"services":["cloud.firestore"]}}
